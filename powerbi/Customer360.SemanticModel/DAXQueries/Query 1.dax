// Expected values independently verified with Python and SQL Server.
EVALUATE
VAR Checks = UNION(
    ROW("Check", "Revenue", "Actual", [Revenue], "Expected", 53357307150),
    ROW("Check", "Completed orders", "Actual", [Completed Orders], "Expected", 2998),
    ROW("Check", "All orders", "Actual", [All Orders], "Expected", 3200),
    ROW("Check", "Cancelled orders", "Actual", [Cancelled Orders], "Expected", 202),
    ROW("Check", "Buying customers", "Actual", [Buying Customers], "Expected", 575),
    ROW("Check", "Repeat buyers", "Actual", [Repeat Buyers], "Expected", 516),
    ROW("Check", "Line revenue", "Actual", [Line Revenue], "Expected", 53795867150),
    ROW("Check", "Gross line profit", "Actual", [Gross Line Profit], "Expected", 11609687150),
    ROW("Check", "Coupons", "Actual", [Order Coupons], "Expected", 451450000),
    ROW("Check", "Shipping", "Actual", [Shipping Fees], "Expected", 12890000),
    ROW("Check", "Reconciliation", "Actual", [Revenue Reconciliation], "Expected", 0),
    ROW("Check", "Snapshot customers", "Actual", [Snapshot Customers], "Expected", 600),
    ROW("Check", "At risk", "Actual", [At Risk Customers], "Expected", 66),
    ROW("Check", "Retention assigned", "Actual", [Retention Eligible], "Expected", 48),
    ROW("Check", "Cross sell assigned", "Actual", [Cross Sell Assigned], "Expected", 92),
    ROW("Check", "Service recovery assigned", "Actual", [Service Recovery Assigned], "Expected", 12),
    ROW("Check", "Champion assigned", "Actual", [Champion Care Assigned], "Expected", 81),
    ROW("Check", "Valid service", "Actual", [Valid Service Requests], "Expected", 231),
    ROW("Check", "Invalid service", "Actual", [Invalid Service Requests], "Expected", 1),
    ROW("Check", "Open service requests", "Actual", [Open Service Requests], "Expected", 13),
    ROW("Check", "January M1 buyers", "Actual", CALCULATE([Cohort Active Buyers], Customer360[cohort_month]="2025-01", CohortAge[MonthIndex]=1), "Expected", 61),
    ROW("Check", "January cohort size", "Actual", CALCULATE([Cohort Size], Customer360[cohort_month]="2025-01"), "Expected", 154),
    ROW("Check", "December M1 blank", "Actual", INT(ISBLANK(CALCULATE([Cohort Retention], Customer360[cohort_month]="2025-12", CohortAge[MonthIndex]=1))), "Expected", 1),
    ROW("Check", "Marketplace orders", "Actual", CALCULATE([All Orders],fact_order[sales_channel]="Marketplace"), "Expected", 293),
    ROW("Check", "Marketplace cancellations", "Actual", CALCULATE([Cancelled Orders],fact_order[sales_channel]="Marketplace"), "Expected", 52),
    ROW("Check", "December returning revenue", "Actual", CALCULATE([Returning Revenue],DimDate[MonthNumber]=12), "Expected", 5881205700),
    ROW("Check", "Q4 revenue", "Actual", CALCULATE([Revenue],DimDate[MonthNumber]>=10), "Expected", 16666401950),
    ROW("Check", "Q4 returning revenue", "Actual", CALCULATE([Returning Revenue],DimDate[MonthNumber]>=10), "Expected", 14810629100),
    ROW("Check", "dim_region rows", "Actual", COUNTROWS(dim_region), "Expected", 3),
    ROW("Check", "dim_branch rows", "Actual", COUNTROWS(dim_branch), "Expected", 12),
    ROW("Check", "dim_customer rows", "Actual", COUNTROWS(dim_customer), "Expected", 600),
    ROW("Check", "dim_category rows", "Actual", COUNTROWS(dim_category), "Expected", 8),
    ROW("Check", "dim_product rows", "Actual", COUNTROWS(dim_product), "Expected", 48),
    ROW("Check", "fact_order rows", "Actual", COUNTROWS(fact_order), "Expected", 3200),
    ROW("Check", "fact_order_detail rows", "Actual", COUNTROWS(fact_order_detail), "Expected", 6008),
    ROW("Check", "fact_service_request rows", "Actual", COUNTROWS(fact_service_request), "Expected", 232),
    ROW("Check", "Customer360 rows", "Actual", COUNTROWS(Customer360), "Expected", 600),
    ROW("Check", "DimDate rows", "Actual", COUNTROWS(DimDate), "Expected", 365),
    ROW("Check", "CohortAge rows", "Actual", COUNTROWS(CohortAge), "Expected", 12),
    ROW("Check", "_Measures rows", "Actual", COUNTROWS(_Measures), "Expected", 1)
)
VAR Failures = FILTER(Checks, ISBLANK([Actual]) || ABS([Actual]-[Expected])>0.000001)
RETURN ROW("Checks",COUNTROWS(Checks),"Passed",COUNTROWS(Checks)-COUNTROWS(Failures),"Failed",COUNTROWS(Failures),"Details",CONCATENATEX(Failures,[Check]&": "&FORMAT([Actual],"0.########")&" expected "&FORMAT([Expected],"0.########"),"; "))
