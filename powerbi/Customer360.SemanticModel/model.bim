            "formatString": "#,0",
            "lineageTag": "9d1c1d96-0291-5493-b7fe-32114926b31d",
            "sourceColumn": "MonthIndex",
            "summarizeBy": "none"
          },
          {
            "name": "MonthLabel",
            "dataType": "string",
            "lineageTag": "f1916203-9387-42da-b358-0679039fbf94",
            "sortByColumn": "MonthIndex",
            "sourceColumn": "MonthLabel",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "29312f86-b2a2-5900-8134-8eea8739678d",
        "partitions": [
          {
            "name": "CohortAge",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " T = Table.FromList({0..11}, Splitter.SplitByNothing(), {\"MonthIndex\"}),",
                " Typed = Table.TransformColumnTypes(T, {{\"MonthIndex\", Int64.Type}}),",
                " Final = Table.AddColumn(Typed, \"MonthLabel\", each if [MonthIndex] = 0 then \"Số khách\" else \"M\" & Text.From([MonthIndex]), type text)",
                "in",
                " Final"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "placeholder",
            "dataType": "int64",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "73bc2781-4991-5c6c-b68f-79515a3c3ca8",
            "sourceColumn": "placeholder",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "b7c8d715-0b4b-54ab-8884-165f56880cb6",
        "measures": [
          {
            "name": "Revenue",
            "description": "Doanh thu đơn Completed, đã trừ coupon cấp đơn và cộng phí giao hàng; chưa tự trừ refund.",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(fact_order[order_total_amount]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "9ed04438-6af2-580c-b559-4b7d4424a883"
          },
          {
            "name": "Revenue Bn",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Revenue],1000000000)",
            "formatString": "0.00\" tỷ ₫\"",
            "lineageTag": "40e3c412-1d6b-5473-829f-97b8563b3936"
          },
          {
            "name": "Completed Orders",
            "displayFolder": "Sales",
            "expression": "CALCULATE(COUNTROWS(fact_order), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "c8a26633-8e2a-50d0-a846-402d81ac1e89"
          },
          {
            "name": "All Orders",
            "displayFolder": "Sales",
            "expression": "COUNTROWS(fact_order)",
            "formatString": "#,0",
            "lineageTag": "9122e1a1-e097-5209-abda-88cd8370870f"
          },
          {
            "name": "Cancelled Orders",
            "displayFolder": "Sales",
            "expression": "CALCULATE(COUNTROWS(fact_order), KEEPFILTERS(fact_order[order_status] = \"Cancelled\"))",
            "formatString": "#,0",
            "lineageTag": "d0e289c3-ee43-5483-97ba-99543daab470"
          },
          {
            "name": "Cancellation Rate",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Cancelled Orders],[All Orders])",
            "formatString": "0.0%",
            "lineageTag": "8e1dfe99-19a6-50e6-a0ea-a7781071aeea"
          },
          {
            "name": "AOV",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Revenue],[Completed Orders])",
            "formatString": "#,0",
            "lineageTag": "3664359e-2da8-5cba-9fa7-a1b2ae3d1ae9"
          },
          {
            "name": "AOV Mn",
            "displayFolder": "Sales",
            "expression": "DIVIDE([AOV],1000000)",
            "formatString": "0.00\" triệu ₫\"",
            "lineageTag": "cceaf4e4-dec6-5487-8ec3-ead99f14df18"
          },
          {
            "name": "Buying Customers",
            "displayFolder": "Sales",
            "expression": "CALCULATE(DISTINCTCOUNT(fact_order[customer_id]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "e8b33f1c-5747-57a5-9170-59c95f0aa883"
          },
          {
            "name": "Repeat Buyers",
            "displayFolder": "Sales",
            "expression": "COUNTROWS(FILTER(VALUES(Customer360[customer_id]), [Completed Orders] >= 2))",
            "formatString": "#,0",
            "lineageTag": "6db4b118-3b95-5799-a3a0-ef9edd54f4e4"
          },
          {
            "name": "Repeat Buyer Rate",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Repeat Buyers],[Buying Customers])",
            "formatString": "0.0%",
            "lineageTag": "566dcb82-8fd3-5fae-bcbd-d0bc60a82101"
          },
          {
            "name": "Revenue Previous Month",
            "displayFolder": "Sales",
            "expression": "CALCULATE([Revenue], DATEADD(DimDate[Date],-1,MONTH))",
            "formatString": "#,0",
            "lineageTag": "e342f71b-7dce-519d-ba8b-35d1cdba7e28"
          },
          {
            "name": "Revenue MoM",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Revenue]-[Revenue Previous Month],[Revenue Previous Month])",
            "formatString": "0.0%",
            "lineageTag": "62799b81-d81a-5350-93bb-7fe56922c7f9"
          },
          {
            "name": "Returning Revenue",
            "displayFolder": "Sales",
            "expression": "CALCULATE([Revenue], KEEPFILTERS(fact_order[purchase_month_type] = \"Khách quay lại\"))",
            "formatString": "#,0",
            "lineageTag": "34a6620c-cb21-56a8-b4c8-4026f61e583e"
          },
          {
            "name": "Returning Revenue Share",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Returning Revenue],[Revenue])",
            "formatString": "0.0%",
            "lineageTag": "a9c6686f-3b7e-5341-97e7-c2087ae39329"
          },
          {
            "name": "Units Sold",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(fact_order_detail[quantity]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "96ae5411-7f16-5ec7-9b61-db138e111b60"
          },
          {
            "name": "Line Revenue",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(fact_order_detail[line_revenue]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "ca0a7d88-d067-5c99-a8c6-310cf730eb30"
          },
          {
            "name": "Line Revenue Bn",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Line Revenue],1000000000)",
            "formatString": "0.00\" tỷ ₫\"",
            "lineageTag": "7071dc87-d9fa-5584-ba3d-9650055276ac"
          },
          {
            "name": "Gross Line Profit",
            "description": "Lợi nhuận gộp dòng hàng trước coupon đơn, shipping, refund, chi phí vận hành; dùng unit_cost nguồn.",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(fact_order_detail[line_profit]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "c1fa5a69-85c3-522f-9dfe-99c741cc1975"
          },
          {
            "name": "Gross Line Profit Bn",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Gross Line Profit],1000000000)",
            "formatString": "0.00\" tỷ ₫\"",
            "lineageTag": "0e2a4f9c-3d54-5f58-846f-fd0c763f722c"
          },
          {
            "name": "Gross Line Margin",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Gross Line Profit],[Line Revenue])",
            "formatString": "0.0%",
            "lineageTag": "fa183a60-1ca6-51b1-839c-9aa73210c89b"
          },
          {
            "name": "Target Margin",
            "displayFolder": "Sales",
            "expression": "IF(HASONEVALUE(dim_category[category_id]), MAX(dim_category[target_margin_pct]))",
            "formatString": "0.0%",
            "lineageTag": "cd890b4c-8fc3-59b2-933d-75f357becc2c"
          },
          {
            "name": "Margin Gap pp",
            "displayFolder": "Sales",
            "expression": "IF(HASONEVALUE(dim_category[category_id]),100*([Gross Line Margin]-[Target Margin]))",
            "formatString": "0.0\" điểm %\"",
            "lineageTag": "5cb2f035-b9b5-5da2-8caa-b35035c78522"
          },
          {
            "name": "Annual Branch Target",
            "displayFolder": "Sales",
            "expression": "SUM(dim_branch[annual_revenue_target])",
            "formatString": "#,0",
            "lineageTag": "c525928b-4a43-58f7-b550-9074f4b30af7"
          },
          {
            "name": "Annual Branch Revenue",
            "displayFolder": "Sales",
            "expression": "CALCULATE([Revenue], REMOVEFILTERS(DimDate), REMOVEFILTERS(fact_order[sales_channel]))",
            "formatString": "#,0",
            "lineageTag": "fd4cf8d9-71ba-5b6c-87ca-d3154a33cd13"
          },
          {
            "name": "Annual Target Attainment",
            "description": "Doanh thu cả năm 2025 / mục tiêu năm theo chi nhánh; bỏ bộ lọc tháng và kênh để giữ mẫu số đúng.",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Annual Branch Revenue],[Annual Branch Target])",
            "formatString": "0.0%",
            "lineageTag": "e28a56a3-e6b4-5e17-89ea-1a5c361cdef6"
          },
          {
            "name": "Order Coupons",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(fact_order[order_discount_amount]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "36309bda-79c6-518b-a30f-a0e6bf9cc603"
          },
          {
            "name": "Shipping Fees",
            "displayFolder": "Sales",
            "expression": "CALCULATE(SUM(fact_order[shipping_fee]), KEEPFILTERS(fact_order[order_status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "bb4057e7-5f9d-57b1-a609-9ca0c172aab7"
          },
          {
            "name": "Revenue Reconciliation",
            "displayFolder": "Validation",
            "expression": "[Line Revenue]-[Order Coupons]+[Shipping Fees]-[Revenue]",
            "formatString": "#,0",
            "lineageTag": "978942ed-f1c4-57fa-aa87-b2dbd4dbaff8"
          },
          {
            "name": "Snapshot Customers",
            "displayFolder": "Customer snapshot",
            "expression": "COUNTROWS(Customer360)",
            "formatString": "#,0",
            "lineageTag": "0b724f2f-c533-57ad-aeed-ccf3b33d84b3"
          },
          {
            "name": "Snapshot Revenue Bn",
            "displayFolder": "Customer snapshot",
            "expression": "DIVIDE(SUM(Customer360[total_revenue]),1000000000)",
            "formatString": "0.00\" tỷ ₫\"",
            "lineageTag": "47d74a6e-2815-506f-a4f4-dcc9f0e1cda6"
          },
          {
            "name": "At Risk Customers",
            "displayFolder": "Customer snapshot",
            "expression": "CALCULATE(COUNTROWS(Customer360), KEEPFILTERS(Customer360[segment] = \"High Value At Risk\"))",
            "formatString": "#,0",
            "lineageTag": "434e63eb-0985-5588-bd4c-8da25a67e485"
          },
          {
            "name": "Retention Eligible",
            "displayFolder": "Customer snapshot",
            "expression": "CALCULATE(COUNTROWS(Customer360), KEEPFILTERS(Customer360[next_action] = \"02 Giữ chân\"))",
            "formatString": "#,0",
            "lineageTag": "2d19d1b1-888c-5e1e-8286-6c69fee4eaa5"
          },
          {
            "name": "Cross Sell Assigned",
            "displayFolder": "Customer snapshot",
            "expression": "CALCULATE(COUNTROWS(Customer360), KEEPFILTERS(Customer360[next_action] = \"04 Bán chéo Audio\"))",
            "formatString": "#,0",
            "lineageTag": "f7daca66-b39e-5a50-a3c9-1f7507857f65"
          },
          {
            "name": "Service Recovery Assigned",
            "displayFolder": "Customer snapshot",
            "expression": "CALCULATE(COUNTROWS(Customer360), KEEPFILTERS(Customer360[next_action] = \"01 Xử lý dịch vụ\"))",
            "formatString": "#,0",
            "lineageTag": "e3339921-8af7-5a6c-85b3-9917f8fc1b34"
          },
          {
            "name": "Champion Care Assigned",
            "displayFolder": "Customer snapshot",
            "expression": "CALCULATE(COUNTROWS(Customer360), KEEPFILTERS(Customer360[next_action] = \"03 Chăm sóc Champion\"))",
            "formatString": "#,0",
            "lineageTag": "9d1d454e-e8cf-5f78-82f6-ba4e492404c4"
          },
          {
            "name": "Valid Service Requests",
            "displayFolder": "Service",
            "expression": "CALCULATE(COUNTROWS(fact_service_request), KEEPFILTERS(fact_service_request[is_valid_temporal] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "e7a9d88a-bd97-5d35-91c5-484b3993a3f0"
          },
          {
            "name": "Invalid Service Requests",
            "displayFolder": "Validation",
            "expression": "CALCULATE(COUNTROWS(fact_service_request), KEEPFILTERS(fact_service_request[is_valid_temporal] = FALSE()))",
            "formatString": "#,0",
            "lineageTag": "8a9c9b2e-3acf-5e29-91c7-d72693a41b9c"
          },
          {
            "name": "Open Service Requests",
            "displayFolder": "Service",
            "expression": "CALCULATE([Valid Service Requests], KEEPFILTERS(fact_service_request[resolution_status] = \"Open\"))",
            "formatString": "#,0",
            "lineageTag": "cebba3be-d6a2-5c2d-9233-8fc4641f74b8"
          },
          {
            "name": "Avg Resolution Days",
            "displayFolder": "Service",
            "expression": "CALCULATE(AVERAGE(fact_service_request[resolution_days]), fact_service_request[is_valid_temporal] = TRUE(), KEEPFILTERS(fact_service_request[resolution_status] = \"Resolved\"))",
            "formatString": "0.0\" ngày\"",
            "lineageTag": "12eeefe6-c1c3-5aa6-8122-090a97452814"
          },
          {
            "name": "CSAT Resolved",
            "displayFolder": "Service",
            "expression": "CALCULATE(AVERAGE(fact_service_request[satisfaction_score]), fact_service_request[is_valid_temporal] = TRUE(), KEEPFILTERS(fact_service_request[resolution_status] = \"Resolved\"))",
            "formatString": "0.00\" / 5\"",
            "lineageTag": "b7ede0ca-8c6d-5442-8e73-8ace237d592d"
          },
          {
            "name": "Requests Per 100 Units",
            "description": "Yêu cầu dịch vụ / 100 sản phẩm bán; không phải tỷ lệ lỗi, thời gian phát sinh request khác thời gian bán.",
            "displayFolder": "Service",
            "expression": "DIVIDE(100*[Valid Service Requests],[Units Sold])",
            "formatString": "0.0",
            "lineageTag": "be0a6697-4518-5954-95e0-4793ff622822"
          },
          {
            "name": "Service Refunds",
            "displayFolder": "Service",
            "expression": "CALCULATE(SUM(fact_service_request[refund_amount]), fact_service_request[is_valid_temporal] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "32697802-7c47-5fe4-9bcf-068fa23dec8a"
          },
          {
            "name": "Cohort Size",
            "displayFolder": "Cohort",
            "expression": "CALCULATE(COUNTROWS(Customer360), Customer360[completed_orders] > 0)",
            "formatString": "#,0",
            "lineageTag": "7de661b2-c980-53e4-b1dd-866c5b580aa8"
          },
          {
            "name": "Cohort Active Buyers",
            "displayFolder": "Cohort",
            "expression": [
              "VAR Cohort = SELECTEDVALUE(Customer360[cohort_month_date]) VAR OffsetMonths = SELECTEDVALUE(CohortAge[MonthIndex]) VAR MonthStart = EDATE(Cohort,OffsetMonths) VAR PeriodEnd = EDATE(MonthStart,1) RETURN IF(ISBLANK(Cohort) || ISBLANK(OffsetMonths) || MonthStart > DATE(2025,12,1), BLANK(), CALCULATE([Buying Customers], REMOVEFILTERS(DimDate), fact_order[order_date] >= MonthStart, fact_order[order_date] < PeriodEnd))",
              ""
            ],
            "formatString": "#,0",
            "lineageTag": "96e04fd7-025f-5b64-b4b3-74551b50f36e"
          },
          {
            "name": "Cohort Retention",
            "description": "Số người của cohort có mua Completed ở tháng M / quy mô cohort. Tháng chưa quan sát trả BLANK, không phải 0%.",
            "displayFolder": "Cohort",
            "expression": "DIVIDE([Cohort Active Buyers],[Cohort Size])",
            "formatString": "0.0%",
            "lineageTag": "c8a14535-cbec-5100-badf-9425552dfeca"
          },
          {
            "name": "Header Overview",
            "displayFolder": "Labels",
            "expression": "\"CUSTOMER 360  /  TỔNG QUAN 2025\"",
            "lineageTag": "0129b905-aebf-5c14-8089-adc364776ac9"
          },
          {
            "name": "Header Customers",
            "displayFolder": "Labels",
            "expression": "\"CUSTOMER 360  /  KHÁCH HÀNG & HÀNH ĐỘNG\"",
            "lineageTag": "17e7c346-42e9-56f3-a927-d8efe800d0dd"
          },
          {
            "name": "Header Sales",
            "displayFolder": "Labels",
            "expression": "\"CUSTOMER 360  /  BÁN HÀNG & HIỆU QUẢ\"",
            "lineageTag": "6947feb9-acec-56ab-997e-2734ca2cd97b"
          },
          {
            "name": "Header Cohort",
            "displayFolder": "Labels",
            "expression": "\"CUSTOMER 360  /  COHORT & MUA LẠI\"",
            "lineageTag": "0c2e5985-8440-58d4-be3d-48b7c852edd6"
          },
          {
            "name": "Header Service",
            "displayFolder": "Labels",
            "expression": "\"CUSTOMER 360  /  DỊCH VỤ KHÁCH HÀNG\"",
            "lineageTag": "dab4f844-38a1-5755-bca2-55a2dbe6818e"
          },
          {
            "name": "Retention M1 Weighted",
            "displayFolder": "Review additions",
            "expression": [
              "VAR EligibleCohorts = FILTER(VALUES(Customer360[cohort_month_date]), NOT ISBLANK(Customer360[cohort_month_date]) && Customer360[cohort_month_date] < DATE(2025,12,1))",
              "VAR Returned = SUMX(EligibleCohorts, CALCULATE([Cohort Active Buyers], REMOVEFILTERS(CohortAge), CohortAge[MonthIndex] = 1))",
              "VAR Base = SUMX(EligibleCohorts, CALCULATE([Cohort Size], REMOVEFILTERS(DimDate), REMOVEFILTERS(CohortAge)))",
              "RETURN DIVIDE(Returned, Base)"
            ],
            "formatString": "0.0%",
            "lineageTag": "556e9247-9527-4ae5-a3cf-4feff48e300d"
          },
          {
            "name": "Cohort Cell",
            "displayFolder": "Review additions",
            "expression": [
              "",
              "VAR Age = SELECTEDVALUE(CohortAge[MonthIndex])",
              "VAR CohortDate = SELECTEDVALUE(Customer360[cohort_month_date])",
              "VAR Rate = [Cohort Retention]",
              "RETURN IF(NOT HASONEVALUE(Customer360[cohort_month]) || ISBLANK(CohortDate), BLANK(), IF(Age = 0, FORMAT([Cohort Size], \"#,0\"), IF(ISBLANK(Rate), BLANK(), FORMAT(Rate,\"0.0%\"))))",
              "",
              ""
            ],
            "lineageTag": "9f9843bb-ec20-46b3-9439-cfa9ba41a893"
          },
          {
            "name": "Cohort Cell Background",
            "displayFolder": "Review additions",
            "expression": [
              "VAR Age = SELECTEDVALUE(CohortAge[MonthIndex]) VAR R = [Cohort Retention]",
              "RETURN SWITCH(TRUE(), Age = 0, \"#F0E8DA\", ISBLANK(R), \"#FFFFFF\", R < 0.15, \"#F1F4F8\", R < 0.30, \"#DAE4EF\", R < 0.45, \"#A6BDD2\", R < 0.60, \"#597FA4\", R < 0.75, \"#365779\", \"#192B43\")"
            ],
            "lineageTag": "5dbfe889-1b83-473d-a24f-76e58453c25b"
          },
          {
            "name": "Cohort Cell Foreground",
            "displayFolder": "Review additions",
            "expression": "IF(SELECTEDVALUE(CohortAge[MonthIndex]) > 0 && [Cohort Retention] >= 0.45, \"#FFFFFF\", \"#24354B\")",
            "lineageTag": "4b65bdb8-0495-46c2-99ef-69b88933e09e"
          },
          {
            "name": "CSAT Open",
            "displayFolder": "Review additions",
            "expression": "CALCULATE(AVERAGE(fact_service_request[satisfaction_score]), fact_service_request[is_valid_temporal] = TRUE(), KEEPFILTERS(fact_service_request[resolution_status] = \"Open\"))",
            "formatString": "0.00",
            "lineageTag": "984cb363-f2da-4626-99f1-ee05f32d1afc"
          },
          {
            "name": "Margin Gap Color",
            "displayFolder": "Review additions",
            "expression": "IF([Margin Gap pp] < 0, \"#AE4C50\", \"#24354B\")",
            "lineageTag": "6fdb40b8-ef36-4246-8e27-268a70e78ae2"
          },
          {
            "name": "Branch Target Background",
            "displayFolder": "Review additions",
            "expression": "IF(NOT ISBLANK([Annual Target Attainment]) && [Annual Target Attainment] < 0.6, \"#F8E3E4\", \"#FFFFFF\")",
            "lineageTag": "68cb26f8-7395-4368-8a45-713ade13a8d1"
          },
          {
            "name": "Branch Target Color",
            "displayFolder": "Review additions",
            "expression": "IF([Annual Target Attainment] < 0.6, \"#AE4C50\", \"#24354B\")",
            "lineageTag": "66604939-6c52-4875-8990-1fcd2e122b89"
          },
          {
            "name": "Snapshot Customer Share",
            "displayFolder": "Review additions",
            "expression": "DIVIDE([Snapshot Customers], CALCULATE([Snapshot Customers], REMOVEFILTERS(Customer360[segment])))",
            "formatString": "0.0%",
            "lineageTag": "98a13451-92c6-4aed-923b-f3eca8d3d178"
          },
          {
            "name": "Snapshot Revenue Share",
            "displayFolder": "Review additions",
            "expression": "DIVIDE([Snapshot Revenue Bn], CALCULATE([Snapshot Revenue Bn], REMOVEFILTERS(Customer360[segment])))",
            "formatString": "0.0%",
            "lineageTag": "fc208d72-5074-4708-9fa7-a3e25005bee9"
          },
          {
            "name": "Average Monthly Revenue Bn",
            "displayFolder": "Review additions",
            "expression": "VAR MonthsInYear = CALCULATETABLE(VALUES(DimDate[MonthNumber]), REMOVEFILTERS(DimDate)) RETURN AVERAGEX(MonthsInYear, VAR M = DimDate[MonthNumber] RETURN CALCULATE([Revenue Bn], REMOVEFILTERS(DimDate), DimDate[MonthNumber] = M))",
            "formatString": "0.00",
            "lineageTag": "1b9a1273-bc17-4314-9cd4-9079460a77b6"
          },
          {
            "name": "Hai Chau Resolution Days",
            "displayFolder": "Review additions",
            "expression": "CALCULATE([Avg Resolution Days], KEEPFILTERS(dim_branch[branch_id] = \"B005\"))",
            "formatString": "0.00",
            "lineageTag": "5aa93c3a-961e-4131-b075-67848c04374e"
          },
          {
            "name": "Service Attention Line",
            "displayFolder": "Review additions",
            "expression": "\"CSAT yêu cầu đang mở: \" & IF(ISBLANK([CSAT Open]), \"—\", FORMAT([CSAT Open],\"0.00\")) & \"/5  |  Hải Châu: \" & IF(ISBLANK([Hai Chau Resolution Days]), \"—\", FORMAT([Hai Chau Resolution Days],\"0.00\")) & \" ngày xử lý (đã xử lý)\"",
            "lineageTag": "4456b3da-ec6f-4a8f-b205-a3c50da2993f"
          }
        ],
