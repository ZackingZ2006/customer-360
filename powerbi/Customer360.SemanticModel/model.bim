        "lineageTag": "6515ce1b-624d-5029-a823-faa52fd1f32b",
        "partitions": [
          {
            "name": "fact_order",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/fact_order.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"order_id\", type text}, {\"customer_id\", type text}, {\"branch_id\", type text}, {\"order_date\", type date}, {\"sales_channel\", type text}, {\"payment_method\", type text}, {\"order_status\", type text}, {\"order_discount_amount\", type number}, {\"shipping_fee\", type number}, {\"order_total_amount\", type number}}, \"en-US\"),",
                "    Completed = Table.SelectRows(Typed, each [order_status] = \"Completed\" and [order_date] >= #date(2025,1,1) and [order_date] <= #date(2025,12,31)),",
                "    First = Table.Group(Completed, {\"customer_id\"}, {{\"first_purchase_date\", each List.Min([order_date]), type date}}),",
                "    Join = Table.NestedJoin(Typed, {\"customer_id\"}, First, {\"customer_id\"}, \"First\", JoinKind.LeftOuter),",
                "    Expand = Table.ExpandTableColumn(Join, \"First\", {\"first_purchase_date\"}),",
                "    Classified = Table.AddColumn(Expand, \"purchase_month_type\", each if [order_status] <> \"Completed\" then \"Cancelled\" else if Date.StartOfMonth([order_date]) = Date.StartOfMonth([first_purchase_date]) then \"Khách mới\" else \"Khách quay lại\", type text),",
                "    Final = Table.RemoveColumns(Classified, {\"first_purchase_date\"})",
                "in",
                "    Final"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
