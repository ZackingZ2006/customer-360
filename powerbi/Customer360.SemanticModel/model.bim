                "    Source = Csv.Document(File.Contents(DataFolder & \"/fact_service_request.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"request_id\", type text}, {\"customer_id\", type text}, {\"order_id\", type text}, {\"product_id\", type text}, {\"branch_id\", type text}, {\"request_date\", type date}, {\"request_type\", type text}, {\"issue_group\", type text}, {\"resolution_status\", type text}, {\"resolution_days\", Int64.Type}, {\"refund_amount\", type number}, {\"satisfaction_score\", Int64.Type}}, \"en-US\"),",
                "    Join = Table.NestedJoin(Typed, {\"order_id\"}, fact_order, {\"order_id\"}, \"Order\", JoinKind.LeftOuter),",
                "    Expand = Table.ExpandTableColumn(Join, \"Order\", {\"order_date\"}),",
                "    Valid = Table.AddColumn(Expand, \"is_valid_temporal\", each [request_date] >= [order_date], type logical),",
                "    Final = Table.RemoveColumns(Valid, {\"order_date\"})",
                "in",
                "    Final"
              ],
              "type": "m"
            }
          }
        ]
