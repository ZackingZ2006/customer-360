            "formatString": "#,0",
            "lineageTag": "796c2efe-aa67-5b08-b7b3-82cb6940a529",
            "sourceColumn": "line_profit",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "fa71ad44-bcd6-5148-8fb6-5fa573380447",
        "partitions": [
          {
            "name": "fact_order_detail",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/fact_order_detail.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"order_detail_id\", type text}, {\"order_id\", type text}, {\"product_id\", type text}, {\"quantity\", Int64.Type}, {\"unit_price\", type number}, {\"line_discount_pct\", type number}}, \"en-US\"),",
                "    Rev = Table.AddColumn(Typed, \"line_revenue\", each [quantity] * [unit_price] * (1-[line_discount_pct]/100), Currency.Type),",
                "    Join = Table.NestedJoin(Rev, {\"product_id\"}, dim_product, {\"product_id\"}, \"Product\", JoinKind.LeftOuter),",
                "    Expand = Table.ExpandTableColumn(Join, \"Product\", {\"unit_cost\"}),",
                "    Cost = Table.AddColumn(Expand, \"line_cost\", each [quantity] * [unit_cost], Currency.Type),",
                "    Profit = Table.AddColumn(Cost, \"line_profit\", each [line_revenue] - [line_cost], Currency.Type),",
                "    Final = Table.RemoveColumns(Profit, {\"unit_cost\"})",
                "in",
                "    Final"
              ],
              "type": "m"
            }
          }
        ]
      },
