EVALUATE
VAR Measures = UNION(
    ROW("Measure", "Revenue", "Value", IFERROR(FORMAT([Revenue],"General Number"),"ERROR")),
    ROW("Measure", "Revenue Bn", "Value", IFERROR(FORMAT([Revenue Bn],"General Number"),"ERROR")),
    ROW("Measure", "Completed Orders", "Value", IFERROR(FORMAT([Completed Orders],"General Number"),"ERROR")),
    ROW("Measure", "All Orders", "Value", IFERROR(FORMAT([All Orders],"General Number"),"ERROR")),
    ROW("Measure", "Cancelled Orders", "Value", IFERROR(FORMAT([Cancelled Orders],"General Number"),"ERROR")),
    ROW("Measure", "Cancellation Rate", "Value", IFERROR(FORMAT([Cancellation Rate],"General Number"),"ERROR")),
    ROW("Measure", "AOV", "Value", IFERROR(FORMAT([AOV],"General Number"),"ERROR")),
    ROW("Measure", "AOV Mn", "Value", IFERROR(FORMAT([AOV Mn],"General Number"),"ERROR")),
    ROW("Measure", "Buying Customers", "Value", IFERROR(FORMAT([Buying Customers],"General Number"),"ERROR")),
    ROW("Measure", "Repeat Buyers", "Value", IFERROR(FORMAT([Repeat Buyers],"General Number"),"ERROR")),
    ROW("Measure", "Repeat Buyer Rate", "Value", IFERROR(FORMAT([Repeat Buyer Rate],"General Number"),"ERROR")),
    ROW("Measure", "Revenue Previous Month", "Value", IFERROR(FORMAT([Revenue Previous Month],"General Number"),"ERROR")),
    ROW("Measure", "Revenue MoM", "Value", IFERROR(FORMAT([Revenue MoM],"General Number"),"ERROR")),
    ROW("Measure", "Returning Revenue", "Value", IFERROR(FORMAT([Returning Revenue],"General Number"),"ERROR")),
    ROW("Measure", "Returning Revenue Share", "Value", IFERROR(FORMAT([Returning Revenue Share],"General Number"),"ERROR")),
    ROW("Measure", "Units Sold", "Value", IFERROR(FORMAT([Units Sold],"General Number"),"ERROR")),
    ROW("Measure", "Line Revenue", "Value", IFERROR(FORMAT([Line Revenue],"General Number"),"ERROR")),
    ROW("Measure", "Line Revenue Bn", "Value", IFERROR(FORMAT([Line Revenue Bn],"General Number"),"ERROR")),
    ROW("Measure", "Gross Line Profit", "Value", IFERROR(FORMAT([Gross Line Profit],"General Number"),"ERROR")),
    ROW("Measure", "Gross Line Profit Bn", "Value", IFERROR(FORMAT([Gross Line Profit Bn],"General Number"),"ERROR")),
    ROW("Measure", "Gross Line Margin", "Value", IFERROR(FORMAT([Gross Line Margin],"General Number"),"ERROR")),
    ROW("Measure", "Target Margin", "Value", IFERROR(FORMAT([Target Margin],"General Number"),"ERROR")),
    ROW("Measure", "Margin Gap pp", "Value", IFERROR(FORMAT([Margin Gap pp],"General Number"),"ERROR")),
    ROW("Measure", "Annual Branch Target", "Value", IFERROR(FORMAT([Annual Branch Target],"General Number"),"ERROR")),
    ROW("Measure", "Annual Branch Revenue", "Value", IFERROR(FORMAT([Annual Branch Revenue],"General Number"),"ERROR")),
    ROW("Measure", "Annual Target Attainment", "Value", IFERROR(FORMAT([Annual Target Attainment],"General Number"),"ERROR")),
    ROW("Measure", "Order Coupons", "Value", IFERROR(FORMAT([Order Coupons],"General Number"),"ERROR")),
    ROW("Measure", "Shipping Fees", "Value", IFERROR(FORMAT([Shipping Fees],"General Number"),"ERROR")),
    ROW("Measure", "Revenue Reconciliation", "Value", IFERROR(FORMAT([Revenue Reconciliation],"General Number"),"ERROR")),
    ROW("Measure", "Snapshot Customers", "Value", IFERROR(FORMAT([Snapshot Customers],"General Number"),"ERROR")),
    ROW("Measure", "Snapshot Revenue Bn", "Value", IFERROR(FORMAT([Snapshot Revenue Bn],"General Number"),"ERROR")),
    ROW("Measure", "At Risk Customers", "Value", IFERROR(FORMAT([At Risk Customers],"General Number"),"ERROR")),
    ROW("Measure", "Retention Eligible", "Value", IFERROR(FORMAT([Retention Eligible],"General Number"),"ERROR")),
    ROW("Measure", "Cross Sell Assigned", "Value", IFERROR(FORMAT([Cross Sell Assigned],"General Number"),"ERROR")),
    ROW("Measure", "Service Recovery Assigned", "Value", IFERROR(FORMAT([Service Recovery Assigned],"General Number"),"ERROR")),
    ROW("Measure", "Champion Care Assigned", "Value", IFERROR(FORMAT([Champion Care Assigned],"General Number"),"ERROR")),
    ROW("Measure", "Valid Service Requests", "Value", IFERROR(FORMAT([Valid Service Requests],"General Number"),"ERROR")),
    ROW("Measure", "Invalid Service Requests", "Value", IFERROR(FORMAT([Invalid Service Requests],"General Number"),"ERROR")),
    ROW("Measure", "Open Service Requests", "Value", IFERROR(FORMAT([Open Service Requests],"General Number"),"ERROR")),
    ROW("Measure", "Avg Resolution Days", "Value", IFERROR(FORMAT([Avg Resolution Days],"General Number"),"ERROR")),
    ROW("Measure", "CSAT Resolved", "Value", IFERROR(FORMAT([CSAT Resolved],"General Number"),"ERROR")),
    ROW("Measure", "Requests Per 100 Units", "Value", IFERROR(FORMAT([Requests Per 100 Units],"General Number"),"ERROR")),
    ROW("Measure", "Service Refunds", "Value", IFERROR(FORMAT([Service Refunds],"General Number"),"ERROR")),
    ROW("Measure", "Cohort Size", "Value", IFERROR(FORMAT([Cohort Size],"General Number"),"ERROR")),
    ROW("Measure", "Cohort Active Buyers", "Value", IFERROR(FORMAT([Cohort Active Buyers],"General Number"),"ERROR")),
    ROW("Measure", "Cohort Retention", "Value", IFERROR(FORMAT([Cohort Retention],"General Number"),"ERROR")),
    ROW("Measure", "Header Overview", "Value", IFERROR(FORMAT([Header Overview],"General Number"),"ERROR")),
    ROW("Measure", "Header Customers", "Value", IFERROR(FORMAT([Header Customers],"General Number"),"ERROR")),
    ROW("Measure", "Header Sales", "Value", IFERROR(FORMAT([Header Sales],"General Number"),"ERROR")),
    ROW("Measure", "Header Cohort", "Value", IFERROR(FORMAT([Header Cohort],"General Number"),"ERROR")),
    ROW("Measure", "Header Service", "Value", IFERROR(FORMAT([Header Service],"General Number"),"ERROR"))
)
RETURN ROW("Measures",COUNTROWS(Measures),"Errors",COALESCE(COUNTROWS(FILTER(Measures,[Value]="ERROR")),0),"Results",CONCATENATEX(Measures,[Measure]&"="&[Value],"; "))
